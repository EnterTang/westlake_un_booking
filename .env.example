# Pooled connection URL for the Vercel / serverless runtime (Neon pooled recommended).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?pgbouncer=true&sslmode=require"
# Direct connection URL for Prisma migrations and seeding (Neon direct recommended).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Administrator console password (/admin/login).
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
# HMAC secret for the signed admin session cookie.
SESSION_SECRET="replace-with-a-long-random-session-secret"
# Reserved for future booking-token hardening; edit codes currently use per-code salts.
BOOKING_SECRET="replace-with-a-long-random-booking-secret"

# Optional: Upstash Redis REST credentials for rate limiting only.
# Booking capacity correctness does not depend on Redis.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

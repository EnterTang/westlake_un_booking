# Pooled connection URL for the Vercel runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?pgbouncer=true"
# Direct connection URL for Prisma migrations and seeding.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

ADMIN_PASSWORD="replace-with-a-strong-admin-password"
SESSION_SECRET="replace-with-a-long-random-session-secret"
BOOKING_SECRET="replace-with-a-long-random-booking-secret"

# Optional: used for rate limiting and duplicate-submit protection only.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
